#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
checker="$repo_root/.githooks/check_locales.py"

if command -v powershell.exe >/dev/null 2>&1; then
  exec powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$repo_root/.githooks/check_locales.ps1"
fi

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoLogo -NoProfile -File "$repo_root/.githooks/check_locales.ps1"
fi

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$checker"
fi

if command -v python >/dev/null 2>&1; then
  exec python "$checker"
fi

if command -v py >/dev/null 2>&1; then
  exec py -3 "$checker"
fi

echo "[pre-commit] Python 3 est requis pour vérifier les fichiers de locales." >&2
exit 1
